# ==============================================================================
# CyberNet Environment Variables Configuration Template
# Copy this file to .env before starting docker-compose:
#   cp .env.example .env
# ==============================================================================

# Application Profile & Port
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
DB_HOST=db
DB_PORT=3306
DB_NAME=tiemnet_db
DB_USERNAME=tiemnet_user
DB_PASSWORD=cybernet_secret_pass_123
MYSQL_ROOT_PASSWORD=cybernet_root_pass_456

# Full JDBC URL (used by Spring Boot application-prod.properties)
DB_URL=jdbc:mysql://db:3306/tiemnet_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh

# Security & JWT Token Secrets (Min 256-bit / 32+ characters for HS256)
JWT_SECRET=CyberNetSecretKeyForJwtAuthenticationMustBeAtLeast256BitsLong2026!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
